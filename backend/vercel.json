{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 180,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/market/prizepicks/sync?sport=mlb",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/market/prizepicks/sync?sport=mlb",
      "schedule": "0 21 * * *"
    }
  ]
}
