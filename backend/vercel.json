{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 180,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/news/cron/big-game",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/news/cron/clv-recap",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/news/cron/edge-preview",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/news/cron/line-steam",
      "schedule": "0 22 * * *"
    }
  ]
}
