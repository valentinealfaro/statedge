PORT=4000
NODE_ENV=development

# Database (added in Week 1 — recommend Neon free tier: https://neon.tech)
DATABASE_URL=

# Redis (added later)
REDIS_URL=

# balldontlie.io API key — alternative NBA data source that works from
# datacenter IPs (unlike stats.nba.com). When set, the backend can use it
# as a live fallback for endpoints that aren't yet cached in Postgres.
BALLDONTLIE_API_KEY=

# Firebase Auth (Week 1)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI (Week 4)
OPENAI_API_KEY=

# Stripe (Week 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
