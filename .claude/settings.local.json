{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Edit",
      "Write",
      "Read"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npm publish*)",
      "PowerShell(Remove-Item -Recurse*)",
      "PowerShell(rm -r*)",
      "PowerShell(rmdir /s*)"
    ]
  }
}
